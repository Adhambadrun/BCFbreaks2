rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sales Floor Break Management & Floor Intelligence Rules

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Teams collection
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Breaks collection
    match /breaks/{breakId} {
      allow read, write: if true;
    }

    // WC Tracking
    match /wcTracking/{recordId} {
      allow read, write: if true;
    }

    // Warnings collection
    match /warnings/{warningId} {
      allow read, write: if true;
    }

    // SNN Headlines / news
    match /headlines/{headlineId} {
      allow read, write: if true;
    }

    // Shift Config
    match /config/{configId} {
      allow read, write: if true;
    }

    // Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Broadcasts
    match /broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Shift Notes
    match /shiftNotes/{noteId} {
      allow read, write: if true;
    }

    // Competitions & floor challenges
    match /competitions/{compId} {
      allow read, write: if true;
    }
  }
}
