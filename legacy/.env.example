# ---------------------------------------------------------------------------
# BCFbreaks — Auth0 server configuration
# ---------------------------------------------------------------------------
# Copy to `.env.local` (gitignored) for local work; in deployment set these in
# Vercel / your platform's secret store. Read by server.ts (dotenv, then
# serverAuth.ts). NEVER prefix an Auth0 value with VITE_ — Vite inlines those
# into the public browser bundle, and these are secrets.
#
# ⚠️  Every credential set circulated for this project was pasted in plaintext
#     during setup. Rotate the Client Secret and the AUTH0_SECRET for all three
#     tenants in the Auth0 dashboard before this handles real users.

# Which tenant this deployment talks to: development | staging | production.
# Falls back to VERCEL_ENV (preview -> staging), then NODE_ENV.
AUTH0_ENV="development"

# ---- Flat names: apply to the selected environment (highest precedence) ----
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Signs the session cookie. Any high-entropy value >= 32 chars; per-environment,
# never shared between tenants, and never committed.
AUTH0_SECRET=""

# ---- Or keep all three in one secret store, selected by AUTH0_ENV ----
# AUTH0_DEVELOPMENT_CLIENT_SECRET=""
# AUTH0_DEVELOPMENT_SECRET=""
# AUTH0_STAGING_CLIENT_SECRET=""
# AUTH0_STAGING_SECRET=""
# AUTH0_PRODUCTION_CLIENT_SECRET=""
# AUTH0_PRODUCTION_SECRET=""

# Absolute public origin. Required whenever the request Host header is not the
# browser-visible origin (proxy, VIP, custom domain) — otherwise Auth0 will reject
# the redirect_uri as "not allowed". Example: https://breaks.bcflights.com
# AUTH0_BASE_URL=""

# Optional: OIDC scopes and API audience for the /authorize request.
# AUTH0_SCOPE="openid profile email"
# AUTH0_AUDIENCE="https://api.bcflights.com"

# LOCAL-ONLY. Mints a developer session so the UI can be built without a tenant.
# Refused when NODE_ENV=production. This is not a guest path — the gate still runs.
# Remove the branch in serverAuth.ts (`allowLocalDevSession`) to delete it for good.
# AUTH0_UNAUTHENTICATED_DEV_SESSION="1"

# Existing backend key, unrelated to Auth0.
GEMINI_API_KEY=""
