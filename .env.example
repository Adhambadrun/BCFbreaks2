# =============================================================================
# BCFbreaks — environment template
#
# Copy to `.env.local` (gitignored) for local work. In deployment (Vercel etc.)
# set these in the platform's encrypted environment-variable store per
# environment. NEVER commit real credentials to git.
#
# ⚠️  Credentials for this project were circulated in plaintext during setup.
#     Rotate the Client Secret and AUTH0_SECRET for all three tenants in the
#     Auth0 dashboard before this handles real users.
# =============================================================================

# --- Auth0 (values differ per environment: development / staging / production) ---
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Signs the session cookie. High-entropy value >= 32 chars; per-environment,
# never shared between tenants, never committed.
AUTH0_SECRET=""

# Absolute public origin of the deployment (must match an Allowed Callback /
# Logout URL registered on the Auth0 application). Example:
#   http://localhost:3000          (local)
#   https://bcfbreaks.vercel.app   (production)
APP_BASE_URL=""

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/bcfbreaks"

# --- In-App Email Engine (optional) ---
# Without a key, /api/email/dispatch stores dispatches on the persistent
# RequestRecord ledger (visible in-app). With a key, mail is delivered
# immediately through the Resend HTTP API.
# RESEND_API_KEY=""
# RESEND_FROM="BCFBreaks <requests@bcflights.com>"
